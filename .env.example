# Copy to .env.local for local development (values from `supabase status`).
# On Vercel set the same names in Project → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key

# SERVER ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key

# Synthetic, undeliverable e-mail domain for staff accounts (DECISIONS D-02)
STAFF_EMAIL_DOMAIN=staff.pizzadam.invalid

# Used to build the login links shown in Ayarlar / after creating an employee
APP_BASE_URL=http://localhost:3000
